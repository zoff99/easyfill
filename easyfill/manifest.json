{
  "manifest_version": 2,
  "name": "EasyFill - One-Click Form Filler",
  "version": "1.0.0",
  "description": "Save form answers once and fill every field in one click. Right-click any field to insert your saved values. Unlimited, local-only, open source.",
  "browser_specific_settings": {
    "gecko": {
      "id": "easyfill@easyfill.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "menus",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["src/shared.js", "src/background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/shared.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "browser_action": {
    "default_title": "EasyFill",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  }
}
